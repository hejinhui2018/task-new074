{
  "name": "statevault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "selftest": "esbuild src/engine/selftest.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache-selftest.cjs --log-level=warning && node node_modules/.cache-selftest.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
